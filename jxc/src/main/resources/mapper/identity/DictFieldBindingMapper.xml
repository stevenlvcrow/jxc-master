<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.boboboom.jxc.identity.infrastructure.persistence.mapper.DictFieldBindingMapper">

    <select id="countReferences" resultType="java.lang.Long">
        select count(1)
        from ${tableName}
        where ${columnName} = #{itemCode}
    </select>

    <update id="migrateReferences">
        update ${tableName}
        set ${columnName} = #{newCode}
        where ${columnName} = #{oldCode}
    </update>
</mapper>
