<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3_0.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="localeLanguage" value="zh"/>

    <module name="NewlineAtEndOfFile"/>

    <module name="RegexpSingleline">
        <property name="format" value="[ \t]+$"/>
        <property name="maximum" value="0"/>
        <property name="message" value="行尾禁止空格"/>
    </module>

    <module name="FileLength">
        <property name="max" value="800"/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="System\.out\.print|System\.err\.print"/>
        <property name="message" value="禁止直接使用System.out/err，请使用日志"/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="java\.sql\."/>
        <property name="message" value="禁止直接使用原生JDBC，请使用MyBatis/JPA/JdbcTemplate等框架"/>
        <property name="severity" value="error"/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="DriverManager\.getConnection"/>
        <property name="message" value="禁止直接使用DriverManager获取数据库连接"/>
        <property name="severity" value="error"/>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="Class\.forName.*Driver"/>
        <property name="message" value="禁止硬编码加载JDBC驱动类"/>
        <property name="severity" value="error"/>
    </module>

    <module name="TreeWalker">
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z0-9]+)*$"/>
        </module>

        <module name="TypeName"/>
        <module name="ConstantName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>

        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="ImportOrder">
            <property name="groups" value="java,javax,org,com"/>
            <property name="separated" value="true"/>
        </module>

        <module name="MagicNumber">
            <property name="ignoreHashCodeMethod" value="true"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreFieldDeclaration" value="true"/>
        </module>

        <module name="Indentation">
            <property name="tabWidth" value="4"/>
        </module>

        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="NeedBraces">
            <property name="allowSingleLineStatement" value="false"/>
        </module>

        <module name="AnnotationLocation">
            <property name="allowSamelineSingleParameterlessAnnotation" value="false"/>
            <property name="allowSamelineParameterizedAnnotation" value="false"/>
            <property name="allowSamelineMultipleAnnotations" value="false"/>
        </module>

        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>

        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="minLineCount" value="1"/>
            <property name="allowMissingPropertyJavadoc" value="false"/>
        </module>

        <module name="JavadocParagraph"/>
        <module name="InvalidJavadocPosition"/>

        <module name="CyclomaticComplexity">
            <property name="max" value="10"/>
        </module>
        <module name="NestedIfDepth">
            <property name="max" value="3"/>
        </module>
        <module name="MethodLength">
            <property name="max" value="150"/>
        </module>

        <module name="HiddenField"/>
        <module name="EqualsHashCode"/>
        <module name="ArrayTypeStyle"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="EmptyBlock"/>
    </module>
</module>
